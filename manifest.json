{
  "manifest_version": 3,
  "name": "КЭШ.СТРИМ",
  "short_name": "КЭШ.СТРИМ",
  "version": "0.2.3",
  "description": "Симулятор фрилансера: биржа заказов, штат, инвестиции и офис 90-х.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
