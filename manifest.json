    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://agrsvzssbyhutovflxgv.supabase.co/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
