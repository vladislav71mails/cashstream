{
  "manifest_version": 3,
  "name": "КЭШ.СТРИМ",
  "short_name": "КЭШ.СТРИМ",
  "version": "0.1.0",
  "description": "Кликер-симулятор фрилансера: квесты, казино и офис 90-х.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  }
}
